VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Show OTP in UI when email/SMS providers are not configured (dev only)
VITE_DEV_SHOW_OTP=true

# --- Supabase Edge Function secrets (supabase secrets set NAME=value) ---
# Email (send-verification-email)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=eBihe <noreply@yourdomain.com>

# SMS (send-verification-sms)
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_PHONE_NUMBER=+1234567890
